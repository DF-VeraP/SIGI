  <diagram id="diag-superadmin-04" name="04_Seguridad_IPs_Bloqueadas">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Actor: Atacante / Usuario con Fallos -->
        <mxCell id="act_attacker" value="Cliente / IP Externa" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- Rate Limit Middleware -->
        <mxCell id="box_ratelimit" value="Express Rate Limit&#xa;(loginLimiter)&#xa;Umbral: 5 intentos en 15 min&#xa;keyGenerator: gestorIps.normalizarIp()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="90" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e_rl1" value="POST /login&#xa;(5 intentos fallidos)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="act_attacker" target="box_ratelimit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gestor en Memoria -->
        <mxCell id="box_gestor" value="GestorIpsBloqueadas&#xa;(utils/gestorIps.js)&#xa;- Map&lt;ipNorm, InfoBloqueo&gt;&#xa;- Expiración automática (15 min)&#xa;- Temporizador reactivo&#xa;- Normalización IPv4 / IPv6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e_rl2" value="registrarBloqueo(rawIp)&#xa;HTTP 429 Bloqueo Temporal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="box_ratelimit" target="box_gestor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WebSockets Broadcast -->
        <mxCell id="box_ws" value="Servidor Socket.io&#xa;io.emit('ip_bloqueada', data)&#xa;io.emit('ip_desbloqueada', data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
