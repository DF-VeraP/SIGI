        <mxCell id="sup_act" value="Superadmin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- UI Gestión Usuarios -->
        <mxCell id="ui_user_mgr" value="Módulo de Usuarios (Superadmin)&#xa;1. Catálogo maestro de cuentas&#xa;2. Formulario sin contraseña manual&#xa;3. Regla anti auto-inactivación (HU-SUP-04)&#xa;4. Cambio de rol y estado activo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="210" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="eu1" value="Gestiona cuentas institucionales" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="sup_act" target="ui_user_mgr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RBAC Guard -->
        <mxCell id="rbac_sup" value="RBAC Guard:&#xa;verificarRol('superadmin')&#xa;Previene degradación propia" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="190" height="130" as="geometry" />
        </mxCell>

        <mxCell id="eu2" value="CRUD /api/usuarios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ui_user_mgr" target="rbac_sup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Controller -->
        <mxCell id="ctrl_u" value="Controlador Usuarios&#xa;controllers/usuarios.controller.js&#xa;1. Genera clave temporal numérica (6 dígitos)&#xa;2. Asigna debe_cambiar_password = true&#xa;3. Invalida sesiones activas al inactivar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="215" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="eu3" value="Autorizado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="rbac_sup" target="ctrl_u">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Postgres DB -->
        <mxCell id="db_user" value="PostgreSQL&#xa;Tablas: usuario, rol&#xa;Hash bcrypt (10 rondas)&#xa;debe_cambiar_password = true" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="180" height="130" as="geometry" />
