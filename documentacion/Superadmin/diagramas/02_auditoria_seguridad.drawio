        <mxCell id="box_sources" value="Fuentes de Alimentación Pasiva:&#xa;1. auth.controller.js (LOGIN_EXITOSO, FALLIDO, BLOQUEADO)&#xa;2. usuarios.controller.js (CREAR, EDITAR, ESTADO)&#xa;3. error.middleware.js (Excepciones no controladas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="690" y="440" width="360" height="90" as="geometry" />
