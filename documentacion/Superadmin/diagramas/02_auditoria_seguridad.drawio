          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Postgres DB Auditoría -->
        <mxCell id="db_audit" value="PostgreSQL&#xa;Tabla: auditoria_logs&#xa;(id, accion, usuario_afectado,&#xa;ip, user_agent, timestamp, detalle)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="195" width="230" height="160" as="geometry" />
        </mxCell>

        <mxCell id="el3" value="SELECT * FROM auditoria_logs&#xa;ORDER BY timestamp DESC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ep_audit" target="db_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fuentes Alimentadoras de Auditoría -->
        <mxCell id="box_sources" value="Alimentación Asíncrona Multi-Módulo:&#xa;1. auth: LOGIN_EXITOSO, FALLIDO, BLOQUEADO, RESET_PASSWORD&#xa;2. usuarios: CREAR_USUARIO, EDITAR, CAMBIO_ESTADO&#xa;3. incidentes: TOMAR, LIBERAR, APROBAR, DESESTIMAR, IMPORTAR, ROLLBACK&#xa;4. error.middleware: Captura de 500s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="410" height="100" as="geometry" />
