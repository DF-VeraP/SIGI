        <!-- Endpoint Auditoría -->
        <mxCell id="ep_audit" value="GET /api/usuarios/auditoria/logs&#xa;(RBAC estricto: Superadmin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="220" height="90" as="geometry" />
