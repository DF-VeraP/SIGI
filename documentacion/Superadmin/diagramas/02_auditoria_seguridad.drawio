        <!-- UI Auditoría -->
        <mxCell id="ui_audit" value="Visor de Auditoría Forense (HU-SUP-06)&#xa;1. Timeline cronológico de eventos&#xa;2. Filtros por IP, usuario y tipo de acción&#xa;3. Metadatos de User-Agent y timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="215" width="240" height="120" as="geometry" />
