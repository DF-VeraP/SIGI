        <mxCell id="ui_audit" value="Visor de Auditoría Forense&#xa;1. Timeline de eventos&#xa;2. Filtro por IP / Tipo de evento&#xa;3. Metadatos de navegador / hora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
