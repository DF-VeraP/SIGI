        <mxCell id="inv_a_kpis" value="Renderiza las 7 Tarjetas KPI de Resumen (.contResumen):&#xa;Total Registros (#total), Robos (#robos), Accidentes (#accidentes),&#xa;Piques (#piques), Agresiones (#agresiones),&#xa;Barrio Crítico (#topBarrio) y Vereda Crítica (#topVereda)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3230" y="285" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_a_charts" value="Renderiza los 5 Paneles Gráficos con Chart.js (.estadisticas-grid):&#xa;1. Ranking Top 10 Zonas Críticas (#topZonasList)&#xa;2. Proporción por Tipo de Incidente (Dona #graficoDona)&#xa;3. Evolución de Incidentes - Tendencia (Línea #graficoTendencia)&#xa;4. Distribución por Hora del Día (Barras #graficoHoras)&#xa;5. Comparativo por Categoría (Barras #graficoBarras)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3220" y="405" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="inv_a_matriz" value="Construye la Matriz de Concentración Día × Hora (#matrizDiaHora):&#xa;Cuadrícula de 7 días × 24 horas coloreada por intensidad térmica" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3230" y="550" width="320" height="65" as="geometry" />
