        <mxCell id="mod_auth_box" value="MÓDULO: Inicio de Sesión y Control de Acceso (Login &amp; JWT)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="660" height="1500" as="geometry" /></mxCell>
