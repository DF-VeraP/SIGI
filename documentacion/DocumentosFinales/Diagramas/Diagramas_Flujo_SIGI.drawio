        <mxCell id="auth_dec_act" value="¿Cuenta en estado activo?&#xa;(activo == 1)" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="635" width="200" height="90" as="geometry" /></mxCell>
