        <mxCell id="mod_sup_cat_box" value="MÓDULO: Catálogos con Validación Cromática Perceptual (Redmean)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1230" y="40" width="570" height="1040" as="geometry" /></mxCell>
        <mxCell id="sup_cat_start" value="Inicio: Consola &quot;Administración de Catálogos&quot;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1395" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_cat_in" value="Digita nombre de tipología y elige color hexadecimal" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1395" y="180" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_cat_calc" value="Cálculo de Distancia Perceptual Cromática (Redmean):&#xa;DeltaC = sqrt((2+r/256)*DR^2 + 4*DG^2 + (2+(255-r)/256)*DB^2)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1395" y="270" width="240" height="75" as="geometry" /></mxCell>
