        <mxCell id="mf6_in" value="ENTRADAS:&#xa;- Datos de nuevos usuarios y asignación de roles&#xa;- Órdenes de cambio de estado (Activar/Inactivar)&#xa;- Nuevas tipologías con color hexadecimal en selector&#xa;- Solicitud de reentrenamiento del modelo de IA" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
