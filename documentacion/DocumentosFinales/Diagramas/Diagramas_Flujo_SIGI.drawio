        <mxCell id="e_ini_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1" source="inv_ini_collapse" target="inv_ini_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- =========================================================================================
             MÓDULO 2: BOTÓN DE NAVEGACIÓN "MAPA PRINCIPAL" (#vistaMapa) Y 7 ACCIONES CARTOGRÁFICAS
             ========================================================================================= -->
        <mxCell id="mod_inv_box" value="MÓDULO 2: Botón &quot;Mapa Principal&quot; (#vistaMapa), Capas Territoriales y Barra de 7 Acciones Flotantes" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="980" height="1420" as="geometry" />
        </mxCell>
        <mxCell id="inv_start" value="Inicio: Invitado pulsa botón &quot;Mapa Principal&quot;&#xa;(data-view=&quot;mapa&quot; -&gt; #vistaMapa)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="90" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv_proc_init" value="Inicializa Leaflet.js centrado en Florencia y muestra Cinta KPI (#kpiRibbon):&#xa;Total, Variación mensual, Zona crítica y Predominante&#xa;(Ocultable/reabrible con #btnCerrarKpis y #btnAbrirKpis)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="180" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inv_proc_geom" value="Carga capas vectoriales GeoJSON desde PostGIS:&#xa;- GET /poligonoBarrio (202 Barrios urbanos - Activo por defecto)&#xa;- GET /poligonoVereda (Veredas rurales - Activo por defecto)&#xa;- GET /poligonoCuadrante (8 Cuadrantes MNVCC - Bajo demanda)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1070" y="290" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_proc_req" value="Solicitud asíncrona de incidentes: GET /incidentes" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1100" y="410" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv_dec_filter" value="Filtro de Seguridad Pública en BD:&#xa;¿Incidente con id_estado = 5 (Aprobado)?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="500" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="inv_proc_omit" value="Se descarta del mapa público&#xa;(Invisible al invitado)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="520" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv_end_omit" value="Fin: Incidente oculto" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="845" y="605" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inv_proc_sanit" value="Sanitización de datos confidenciales (omite reportero)&#xa;y agrupamiento espacial dinámico (Leaflet.MarkerCluster)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="630" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="inv_map_dec_fab" value="¿Qué botón flotante de la barra superior&#xa;del mapa (.map-actions-group) pulsa el Invitado?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="730" width="240" height="95" as="geometry" />
        </mxCell>
        <!-- 5 Columnas paralelas para las herramientas flotantes del mapa -->
        <mxCell id="inv_fab_gps" value="1. &quot;Mi ubicación&quot;&#xa;(#btnMiUbicacion):&#xa;Captura GPS HTML5 en vivo,&#xa;centra mapa y muestra pulso" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="885" width="175" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_fab_heat" value="2. &quot;Mapa de calor&quot;&#xa;(#btnToggleHeatmap):&#xa;Activa/desactiva capa de&#xa;densidad kernel (Leaflet.heat)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
