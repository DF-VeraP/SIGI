  <diagram id="tab-arquitectura-rbac" name="Arquitectura-Stack-y-Modelo-RBAC">
    <mxGraphModel dx="2575" dy="1290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="box_arq_stack" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=2;fillColor=#f8fafc;fontColor=#000000;fontFamily=Arial;fontSize=14;collapsible=0;" value="DIAGRAMA 1: ARQUITECTURA DE DESPLIEGUE Y STACK TECNOLÓGICO (SIGI)" vertex="1">
          <mxGeometry height="860" width="1050" x="30" y="40" as="geometry" />
        </mxCell>
        <mxCell id="c_cliente" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="CAPA 1: CLIENTE (FRONTEND WEB &amp; PWA MÓVIL)&#xa;• Visualización Cartográfica: Leaflet.js v1.9.4 + Leaflet.heat&#xa;• Analítica de Indicadores: Chart.js v4.4&#xa;• Capacidad Offline: Service Worker (sw.js) + Cola IndexedDB (pwa-offline.js)&#xa;• Tiempo Real: Socket.io Client (sigi-realtime.js) + Web Audio API&#xa;• Interfaz: HTML5 semántico, CSS3 Vanilla responsivo, JavaScript ES6+" vertex="1">
          <mxGeometry height="120" width="475" x="337.5" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c_seguridad" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#f1f5f9;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="CAPA 2: SEGURIDAD PERIMETRAL, RED Y CONTROL DE ACCESO&#xa;• Protocolo de Transporte: HTTPS con TLS 1.3 / SSL Forzado&#xa;• Hardening HTTP: Helmet (Content Security Policy, HSTS, X-Content-Type)&#xa;• Prevención de Abuso: Express-Rate-Limit (100 peticiones / 15 min por IP)&#xa;• Blindaje Anti-CSRF: Tokens Csurf firmados criptográficamente&#xa;• Protección Fuerza Bruta: GestorIpsBloqueadas en memoria con auditoría" vertex="1">
          <mxGeometry height="120" width="450" x="350" y="290" as="geometry" />
        </mxCell>
        <mxCell id="c_backend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="CAPA 3: SERVIDOR (BACKEND API REST &amp; MICROSERVICIOS EN NODE.JS / EXPRESS)&#xa;• Entorno de Ejecución: Node.js v24.13.1 + Express.js v4.21.2&#xa;• Autenticación &amp; Sesiones: Bcrypt (10 rounds de salt) + Express-Session con Cookies HttpOnly&#xa;• Mesa de Validación Concurrente: Bloqueo de 10 min (locked_by, locked_at)&#xa;• Ingesta y Rollback: Procesamiento streaming CSV-Parser con transacciones ACID&#xa;• Inteligencia Artificial (MLService): Clasificador Naive Bayes, DBSCAN espacial y Pronóstico CIEPS/MNVCC&#xa;• Eventos en Vivo: Servidor WebSocket centralizado con Socket.io" vertex="1">
          <mxGeometry height="140" width="650" x="250" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c_database" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#f1f5f9;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="CAPA 4: PERSISTENCIA (BASE DE DATOS RELACIONAL Y GEOESPACIAL)&#xa;• Motor: PostgreSQL 15 + Extensión Espacial PostGIS 3.3+ (SRID 4326 WGS84)&#xa;• Tablas Transaccionales: usuario, incidente, tipo_incidente, logs_actividad, sesiones&#xa;• Capas Vectoriales: caqueta_urbano (Barrios y Comunas), veredas, cuadrantes MNVCC&#xa;• Indexación de Alto Rendimiento: Índices espaciales GiST y B-Tree en llaves foráneas" vertex="1">
          <mxGeometry height="140" width="550" x="100" y="670" as="geometry" />
        </mxCell>
        <mxCell id="c_cloud" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="CAPA 5: SERVICIOS CLOUD Y EXTERNOS&#xa;• CDN Multimedia: Cloudinary SDK v2 (Almacenamiento y optimización de evidencias)&#xa;• Mensajería SMTP: Nodemailer + SSL (Despacho de claves y tokens)&#xa;• Servidor de Producción: Host Cloud https://sigi.verapd.xyz" vertex="1">
          <mxGeometry height="140" width="350" x="700" y="670" as="geometry" />
        </mxCell>
        <mxCell id="arr_1_2" edge="1" parent="1" source="c_cliente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#000000;" target="c_seguridad" value="Solicitudes HTTPS / REST + WebSocket (WSS)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_2_3" edge="1" parent="1" source="c_seguridad" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#000000;" target="c_backend" value="Peticiones filtradas y sanitizadas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_3_4" edge="1" parent="1" source="c_backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#000000;" target="c_database" value="Consultas SQL y Funciones Espaciales (ST_Contains, ST_Intersects)">
          <mxGeometry relative="1" x="0.7692" y="-15" as="geometry">
