        <mxCell id="mod_adm_an_box" value="MÓDULO: Analítica Predictiva Espacial (DBSCAN) y Pronóstico Temporal" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="760" y="40" width="520" height="960" as="geometry" /></mxCell>
