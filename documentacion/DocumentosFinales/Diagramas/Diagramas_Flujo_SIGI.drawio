        <mxCell id="sup_aud_view" value="Inspección de metadatos forenses: IP, User-Agent, JSON payload" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1970" y="285" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="sup_ml_retrain" value="Superadmin pulsa &quot;Reentrenar Modelo ML&quot;:&#xa;POST /api/ml/reentrenar" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1970" y="380" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="sup_ml_query" value="Extrae relatos de incidentes aprobados (id_estado = 5)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1970" y="475" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_ml_bayes" value="Reconstruye vocabulario y probabilidades a priori&#xa;aplicando suavizado de Laplace en tiempo real" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1970" y="565" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="sup_ml_update" value="Actualiza matriz predictiva en memoria sin reinicio de Node.js" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1970" y="670" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="sup_ml_end" value="Fin: Modelo reentrenado y auditoría verificada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1970" y="765" width="240" height="45" as="geometry" /></mxCell>
