        <mxCell id="mod_rec_box" value="MÓDULO: Recuperación Segura de Contraseña (Token HMAC 60 min)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="750" y="40" width="560" height="1340" as="geometry" /></mxCell>
        <mxCell id="rec_start" value="Inicio: Clic en &quot;¿Olvidó su contraseña?&quot;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="rec_in_email" value="Ingreso de correo institucional" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="180" width="240" height="50" as="geometry" /></mxCell>
