        <mxCell id="box_mf3" value="MF-03: Módulo Funcional de Captura en Campo y Resiliencia Móvil (PWA)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1530" y="90" width="700" height="680" as="geometry" />
        </mxCell>
        <mxCell id="mf3_in" value="ENTRADAS:&#xa;- Coordenadas GPS del sensor móvil&#xa;- Ajuste manual de chincheta por arrastre&#xa;- Relato textual de los hechos y severidad estimada&#xa;- Fotografía capturada con cámara o galería" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="140" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mf3_f1" value="F3.1 Service Worker PWA Offline-First:&#xa;Caché de activos y detección automática de pérdida de señal" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="245" width="310" height="60" as="geometry" />
