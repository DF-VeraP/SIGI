        <mxCell id="rep_rep_render" value="Renderiza listado cronológico con badges:&#xa;- Reportado (Amarillo)&#xa;- En Evaluación (Azul)&#xa;- Aprobado (Verde)&#xa;- Desestimado (Rojo)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="270" width="240" height="80" as="geometry" /></mxCell>
