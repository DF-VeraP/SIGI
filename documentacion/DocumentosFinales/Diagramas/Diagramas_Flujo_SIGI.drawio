        <mxCell id="mf3_f2" value="F3.2 Autolocalización GPS &amp; Contención PostGIS:&#xa;Captura métrica HTML5 + cálculo ST_Contains de barrio/vereda" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="320" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf3_f3" value="F3.3 Asistente NLP Predictivo (Naive Bayes):&#xa;Clasificación automática de tipología a partir del relato escrito" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="395" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf3_f4" value="F3.4 Disparador Semántico de Emergencias:&#xa;Activación automática de casillas (Policía/Ambulancia/Bomberos)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="470" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf3_f5" value="F3.5 Ingesta de Evidencias &amp; Subida Cloudinary:&#xa;Optimización automática de imágenes y compresión web" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="545" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf3_f6" value="F3.6 Cola Offline &amp; Autosincronización:&#xa;Persistencia en localStorage y despacho secuencial al reconectar" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="620" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf3_out" value="SALIDAS OPERATIVAS:&#xa;- Código radicado oficial único (INC-YYYY-XXXX)&#xa;- Notificación toast y modal de confirmación&#xa;- Transmisión en tiempo real vía WebSockets al backend&#xa;- Historial en &quot;Mis Reportes&quot; con badges semafóricos" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1880" y="140" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mf3_sub" value="Submódulos / Dependencias:&#xa;- services/ml.service.js&#xa;- public/sw.js&#xa;- public/js/pwa-offline.js&#xa;- public/reportero/js/reportero.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1880" y="270" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="box_mf4" value="MF-04: Módulo Funcional de Mesa de Validación y Monitoreo en Tiempo Real" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="800" width="700" height="740" as="geometry" />
        </mxCell>
        <mxCell id="mf4_in" value="ENTRADAS:&#xa;- Evento de nuevo incidente radicado en terreno&#xa;- Solicitudes de adquisición / liberación de candado&#xa;- Dictamen técnico del analista (Aprobar / Desestimar)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="850" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="mf4_f1" value="F4.1 Túnel Persistente WebSockets (Socket.io):&#xa;Sala &quot;administradores&quot; con push inmediato a la bandeja" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="945" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf4_f2" value="F4.2 Sintetizador de Tonos Web Audio API:&#xa;Generador de audio armónico nativo (D5 a A5) sin MP3 externo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1020" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf4_f3" value="F4.3 Candado de Concurrencia Transaccional:&#xa;Reserva atómica de 10 min por analista con control de conflicto 409" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1095" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf4_f4" value="F4.4 Asistente IA de Validación Cruzada:&#xa;Comparación heurística entre texto original y tipología seleccionada" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1175" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf4_f5" value="F4.5 Emisión y Registro de Dictamen Técnico:&#xa;Aprobación oficial (id_estado = 5) o desestimación con justificación" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1255" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf4_out" value="SALIDAS OPERATIVAS:&#xa;- Fila insertada dinámicamente en cola sin recarga (F5)&#xa;- Bloqueo de botón para otros analistas (&quot;En revisión por...&quot;)&#xa;- Publicación inmediata en Geoportal ante aprobación&#xa;- Registro inmutable de dictamen en bitácora" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="850" width="330" height="110" as="geometry" />
