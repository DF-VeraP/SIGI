        <mxCell id="auth_err_exist" value="HTTP 401: Credenciales inválidas&#xa;Registra intento fallido" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="525" width="170" height="50" as="geometry" /></mxCell>
