        <mxCell id="mf6_f1" value="F6.1 Aprovisionamiento de Identidades:&#xa;Generación de claves criptográficas y despacho por email (Nodemailer)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="955" width="310" height="60" as="geometry" />
