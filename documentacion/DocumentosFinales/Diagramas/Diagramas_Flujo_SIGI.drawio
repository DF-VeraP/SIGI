        <mxCell id="mod_sup_ip_box" value="MÓDULO: Seguridad Perimetral y Desbloqueo de IPs Bloqueadas" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2400" y="40" width="560" height="920" as="geometry" /></mxCell>
        <mxCell id="sup_ip_start" value="Inicio: Consola &quot;Seguridad IP&quot; (#btnSeguridadIps)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2560" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_ip_req" value="Consulta GET /api/seguridad/ips-bloqueadas&#xa;(Exclusivo rol Superadmin)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="180" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="sup_ip_render" value="Renderiza tabla con badge de IP, motivo,&#xa;hora y temporizador decreciente en vivo (MM:SS)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="275" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="sup_ip_click" value="Superadmin pulsa botón con icono de candado cerrado&#xa;(.btn-icon-usr) en la dirección IP afectada" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="380" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="sup_ip_modal" value="Modal de Confirmación Institucional:&#xa;&quot;¿Está seguro de desbloquear la IP {ip}?&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="480" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="sup_ip_dec_conf" value="¿Superadmin confirma&#xa;el desbloqueo?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2580" y="575" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="sup_ip_cancel" value="Cancela operación:&#xa;Se mantiene el bloqueo perimetral" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2800" y="595" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_ip_post" value="Envía POST /api/seguridad/desbloquear-ip/:ip&#xa;con validación estricta de Token CSRF" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="705" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="sup_ip_purge" value="Purga memoria en loginLimiter (127.0.0.1, ::1, ::/56),&#xa;registra log DESBLOQUEAR_IP y emite io.emit(ip_desbloqueada)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2560" y="805" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="sup_ip_end" value="Fin: Acceso de IP restablecido y tabla actualizada en tiempo real" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2560" y="905" width="240" height="45" as="geometry" /></mxCell>
