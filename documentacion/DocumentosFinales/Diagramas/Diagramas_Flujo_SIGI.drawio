        <mxCell id="erd_estado_incidente" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;estado_incidente (Workflow)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; id_estado: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; nombre: VARCHAR(50)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;descripcion: TEXT&lt;br/&gt;color: VARCHAR(20)&lt;br/&gt;orden: INTEGER&lt;br/&gt;es_final: BOOLEAN DEFAULT false&lt;br/&gt;(1:Reportado, 2:En Evaluac., 5:Aprob., 6:Desestim.)&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1580" y="360" width="360" height="210" as="geometry" /></mxCell>
