        <mxCell id="box_rbac_model" parent="1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=2;fillColor=#f8fafc;fontColor=#000000;fontFamily=Arial;fontSize=14;collapsible=0;" value="DIAGRAMA 2: MODELO DE PERFILES DE USUARIO Y JERARQUÍA RBAC (SIGI)" vertex="1">
          <mxGeometry height="860" width="1200" x="1140" y="40" as="geometry" />
        </mxCell>
        <mxCell id="cls_invitado" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="&lt;b&gt;Perfil: INVITADO (CIUDADANO)&lt;/b&gt;&#xa;&lt;i&gt;Nivel de Acceso: Público / Sin credenciales&lt;/i&gt;&#xa;--------------------------------------------&#xa;+ Acceso a Visor Geográfico Leaflet&#xa;+ Filtrado por Barrio, Tipo y Rango Fecha&#xa;+ Visualización de Tableros Estadísticos (KPIs)&#xa;+ Exploración Tabular de Casos Aprobados&#xa;+ Descarga de Dataset Público en CSV&#xa;+ Solicitud de Recuperación de Contraseña" vertex="1">
          <mxGeometry height="160" width="320" x="1200" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cls_reportero" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="&lt;b&gt;Perfil: REPORTERO (OPERATIVO EN TERRENO)&lt;/b&gt;&#xa;&lt;i&gt;Nivel de Acceso: Autenticado Móvil (rol=&#39;reportero&#39;)&lt;/i&gt;&#xa;--------------------------------------------&#xa;+ Autenticación con Forzado de Clave Inicial&#xa;+ Captura Automática de Coordenadas por GPS&#xa;+ Ajuste Espacial Fino en Mini-Mapa Leaflet&#xa;+ Captura y Subida de Foto a Cloudinary&#xa;+ Radicación con Autolocalización ST_Contains&#xa;+ Asistencia Predictiva por IA en Narrativa&#xa;+ Módulo &quot;Mis Reportes&quot; y Modal de Imagen&#xa;+ Modo Offline PWA con Sincronización Local&#xa;+ Gestión de Perfil y Cambio de Contraseña" vertex="1">
          <mxGeometry height="210" width="330" x="1780" y="110" as="geometry" />
        </mxCell>
        <mxCell id="cls_admin" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="&lt;b&gt;Perfil: ADMINISTRADOR (MESA DE VALIDACIÓN)&lt;/b&gt;&#xa;&lt;i&gt;Nivel de Acceso: Autenticado Operativo (rol=&#39;admin&#39;)&lt;/i&gt;&#xa;--------------------------------------------&#xa;+ Inspección de Cola Compartida de Casos&#xa;+ Adquisición de Candado Exclusivo de 10 Minutos&#xa;+ Liberación Voluntaria de Casos en Revisión&#xa;+ Visualización de Evidencias en Alta Definición&#xa;+ Reclasificación de Gravedad y Tipología con IA&#xa;+ Dictamen: Aprobación (Publicación) o Desestimación&#xa;+ Ingesta Masiva de Incidentes mediante CSV&#xa;+ Rollback Atómico del Último Lote Importado&#xa;+ Generación de Informe Ejecutivo Mensual en PDF&#xa;+ Recepción de Alertas WebSocket en Vivo" vertex="1">
          <mxGeometry height="230" width="340" x="1200" y="380" as="geometry" />
        </mxCell>
        <mxCell id="cls_superadmin" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=15;" value="&lt;b&gt;Perfil: SUPERADMINISTRADOR (GOBERNANZA)&lt;/b&gt;&#xa;&lt;i&gt;Nivel de Acceso: Control Total del Sistema (rol=&#39;superadmin&#39;)&lt;/i&gt;&#xa;--------------------------------------------&#xa;+ Alta de Cuentas Institucionales y Despacho SMTP&#xa;+ Gestión de Roles RBAC e Inactivación Instantánea&#xa;+ Destrucción Forzosa de Sesiones Concurrentes&#xa;+ Salvaguarda de Disponibilidad del Último Superadmin&#xa;+ Desbloqueo Forzoso de Candados Abandonados&#xa;+ Auditoría Forense Completa de Logs de Actividad&#xa;+ Mantenimiento de Catálogos con Algoritmo Redmean&#xa;+ Reentrenamiento Supervisado del Modelo de IA&#xa;+ Monitoreo y Desbloqueo Manual de IPs Bloqueadas" vertex="1">
          <mxGeometry height="230" width="380" x="1880" y="370" as="geometry" />
        </mxCell>
        <mxCell id="box_matriz" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#f1f5f9;fontColor=#000000;fontFamily=Arial;fontSize=12;align=left;spacingLeft=20;" value="&lt;b&gt;MATRIZ DE PRIVILEGIOS Y JERARQUÍA INSTITUCIONAL&lt;/b&gt;&#xa;--------------------------------------------------------------------------------------------------&#xa;• &lt;b&gt;Invitado:&lt;/b&gt; Solo Lectura sobre datos aprobados | Sin acceso a endpoints autenticados&#xa;• &lt;b&gt;Reportero:&lt;/b&gt; Creación de incidentes + Lectura de reportes propios | Sin acceso a validación&#xa;• &lt;b&gt;Administrador:&lt;/b&gt; Lectura + Escritura sobre incidentes | Sin acceso a usuarios ni auditoría global&#xa;• &lt;b&gt;Superadministrador:&lt;/b&gt; Control Total (Gobernanza, Usuarios, Auditoría, IPs y Reentrenamiento IA)" vertex="1">
          <mxGeometry height="140" width="590" x="1420" y="670" as="geometry" />
        </mxCell>
