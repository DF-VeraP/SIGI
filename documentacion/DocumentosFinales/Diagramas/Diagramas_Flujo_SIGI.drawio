        <mxCell id="sup_cat_err_col" value="Alerta de Colisión Visual:&#xa;&quot;El color es indistinguible de otro tipo.&#xa;Seleccione una tonalidad con mayor contraste&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1630" y="395" width="160" height="75" as="geometry" /></mxCell>
