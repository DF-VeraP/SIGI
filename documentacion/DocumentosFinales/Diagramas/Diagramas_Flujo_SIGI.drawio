        <mxCell id="mf6_f3" value="F6.3 Bitácora Forense Inmutable:&#xa;Registro de auditoría con marca ISO 8601, IP origen, User-Agent y JSON" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1105" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf6_f4" value="F6.4 Validación Cromática Perceptual Redmean:&#xa;Control de colisión de color (DeltaC &lt; 85) e integridad referencial" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1180" width="310" height="60" as="geometry" />
