  <diagram id="tab-invitado" name="Flujo-Invitado">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- =========================================================================================
             MÓDULO 1: BOTÓN DE NAVEGACIÓN "INICIO" (#vistaInicio) Y CONTROLES GLOBALES DEL SIDEBAR
             ========================================================================================= -->
        <mxCell id="mod_inv_ini_box" value="MÓDULO 1: Botón &quot;Inicio&quot; (#vistaInicio) y Controles Globales del Sidebar" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="660" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_start" value="Inicio: Invitado ingresa a /dashboard/index.html&#xa;(Vista activa por defecto: Botón &quot;Inicio&quot;)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_hero" value="Renderiza Panel Informativo Oficial SIGI (#vistaInicio):&#xa;- Hero Institucional y cobertura (Florencia Urbana y Rural)&#xa;- 4 Tarjetas descriptivas (Clustering, Heatmaps, Filtros, Matriz)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="185" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_sidebar" value="Inicializa Barra Lateral (Sidebar) y Barra Inferior Móvil:&#xa;- 5 Botones de navegación (Inicio, Mapa Principal, Incidentes, Analítica, AI Lab)&#xa;- Tarjeta de Simbología con conteo en vivo (Robo, Piques, Agresiones, Accidente)&#xa;- Conexión WebSocket (Socket.io) para actualizaciones en tiempo real" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="295" width="320" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_dec_act" value="¿Qué control o botón acciona&#xa;el Invitado desde el Dashboard?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_tema" value="Switch &quot;Tema Claro / Oscuro&quot;&#xa;(#btnTemaHeaderDashboard / Mobile):&#xa;Alterna clase body.tema-claro, guarda en&#xa;localStorage y adapta estilos de mapa y gráficos" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="565" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_cta" value="Botones Hero o Barra de Navegación:&#xa;- &quot;Explorar Mapa de Incidentes&quot;&#xa;- &quot;Ver Analítica y Tendencias&quot;&#xa;- Selección de cualquiera de los 5 módulos" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="275" y="565" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_login" value="Botón &quot;Acceso administrativo&quot;&#xa;(#iniciarSesion / #iniciarSesionMobile):&#xa;Redirige a /login/index.html&#xa;(Conecta con Flujo-Autenticacion-General)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="565" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_router" value="Enrutador SPA de Vistas (cambiarVista(data-view)):&#xa;1. data-view=&quot;inicio&quot; -&gt; Muestra #vistaInicio (Módulo 1)&#xa;2. data-view=&quot;mapa&quot; -&gt; Muestra #vistaMapa y #kpiRibbon (Módulos 2 y 3)&#xa;3. data-view=&quot;tabla&quot; -&gt; Muestra #vistaTabla (Módulo 4)&#xa;4. data-view=&quot;estadisticas&quot; -&gt; Muestra #estadisticas (Módulo 5)&#xa;5. data-view=&quot;ia-hub&quot; -&gt; Muestra #vistaIA (Módulo 6)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="705" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_collapse" value="Opcional: Botón #btnToggleSidebar colapsa o expande&#xa;el menú lateral para maximizar el área de trabajo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="855" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="inv_ini_end" value="Fin: Navegación principal y controles globales activos" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="960" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_ini_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1" source="inv_ini_start" target="inv_ini_hero">
