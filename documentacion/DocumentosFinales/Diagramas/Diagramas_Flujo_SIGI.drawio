        <mxCell id="cont_captura" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" value="ÁREA DE CAPTURA Y GEORREFERENCIACIÓN EN TERRENO" vertex="1">
          <mxGeometry height="660" width="510" y="120" as="geometry" />
        </mxCell>
        <mxCell id="mod_01" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-01: GEOPORTAL PÚBLICO&#xa;&#xa;• Visor Leaflet multipolígono interactivo&#xa;• Cobertura Barrios, Veredas y Cuadrantes MNVCC&#xa;• Capas: Mapa de Calor, Marcadores, Hotspots ML&#xa;• Filtros espacio-temporales dinámicos y Línea de Tiempo&#xa;• Consulta de incidentes validados y Exportación CSV" vertex="1">
          <mxGeometry height="160" width="400" x="60" y="200" as="geometry" />
        </mxCell>
        <mxCell id="mod_02" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-02: CAPTURA EN TERRENO (PWA)&#xa;&#xa;• Adquisición GPS por hardware móvil (alta precisión)&#xa;• Captura y compresión de evidencia fotográfica&#xa;• Subida a CDN Cloudinary (WebP automático)&#xa;• Asistencia predictiva por IA en redacción de descripción&#xa;• Modo PWA Offline: Encolamiento local y sincronización" vertex="1">
          <mxGeometry height="160" width="400" x="60" y="390" as="geometry" />
        </mxCell>
        <mxCell id="mod_08" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" value="MOD-08: TIEMPO REAL &amp;amp; PWA&#xa;&#xa;• Sincronización push reactiva vía WebSockets (Socket.io)&#xa;• Alertas sonoras sintetizadas por Web Audio API&#xa;• Notificación instantánea a operadores y agentes&#xa;• Service Worker: Cache de assets y resiliencia de red" vertex="1">
          <mxGeometry height="150" width="400" x="60" y="580" as="geometry" />
        </mxCell>
        <mxCell id="cont_mesa" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" value="ÁREA DE VALIDACIÓN OPERATIVA, AUDITORÍA Y GOBERNANZA" vertex="1">
          <mxGeometry height="680" width="500" x="750" y="120" as="geometry" />
        </mxCell>
        <mxCell id="mod_03" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-03: MESA DE VALIDACIÓN DE CASOS&#xa;&#xa;• Cola operativa compartida con candados de 10 minutos&#xa;• Prevención estricta de colisiones entre analistas&#xa;• Dictamen multi-criterio: Aprobar, Rechazar, Reclasificar&#xa;• Sugerencias automatizadas por IA (Naive Bayes)&#xa;• Actualización reactiva del estado en tiempo real" vertex="1">
          <mxGeometry height="160" width="400" x="800" y="210" as="geometry" />
        </mxCell>
        <mxCell id="mod_05" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" value="MOD-05: INGESTA MASIVA CSV&#xa;&#xa;• Carga por streaming masivo de datasets históricos&#xa;• Validación estricta fila a fila contra esquemas&#xa;• Rollback transaccional atómico ante fallos en lote&#xa;• Registro forense de descartes y corrección espacial" vertex="1">
          <mxGeometry height="150" width="400" x="800" y="400" as="geometry" />
        </mxCell>
        <mxCell id="mod_06" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-06: SEGURIDAD, AUDITORÍA &amp;amp; RBAC&#xa;&#xa;• Control de Acceso por Roles: 4 Perfiles estrictos&#xa;• Hasheo unidireccional Bcrypt (10 salt rounds)&#xa;• Mitigación de fuerza bruta: Rate Limit y bloqueo perimetral&#xa;• GestorIps: Desbloqueo temporal con countdown en vivo&#xa;• Bitácora forense de auditoría inmutable" vertex="1">
          <mxGeometry height="160" width="400" x="800" y="580" as="geometry" />
        </mxCell>
        <mxCell id="cont_ia" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" value="ÁREA DE INTELIGENCIA ARTIFICIAL, ANALÍTICA Y REPORTES" vertex="1">
          <mxGeometry height="700" width="560" x="1410" y="115" as="geometry" />
        </mxCell>
        <mxCell id="mod_04" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-04: ANALÍTICA AVANZADA &amp;amp; KPIS&#xa;&#xa;• Tableros dinámicos en tiempo real con Chart.js&#xa;• Detección automática de zonas y barrios críticos&#xa;• Matriz Térmica Día × Hora para turnos policiales&#xa;• Análisis de horas pico, estacionalidad y tendencias" vertex="1">
          <mxGeometry height="160" width="400" x="1490" y="200" as="geometry" />
        </mxCell>
        <mxCell id="mod_07" parent="j9Im4GtEjS-vlXEK4Dtm-1" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" value="MOD-07: MACHINE LEARNING &amp;amp; NLP (AI LAB)&#xa;&#xa;• Clasificador Multinomial Naive Bayes con TF-IDF&#xa;• Algoritmo de clustering espacial DBSCAN&#xa;• Pronóstico temporal de series a 4 semanas&#xa;• Mapeo operativo CIEPS &amp;amp; Hoja de Servicio MNVCC&#xa;• Simulador interactivo en vivo de predicción textual" vertex="1">
          <mxGeometry height="160" width="400" x="1490" y="390" as="geometry" />
