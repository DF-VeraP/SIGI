        <mxCell id="auth_proc_find" value="Consulta en PostgreSQL:&#xa;SELECT * FROM usuarios WHERE email = $1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="410" width="240" height="55" as="geometry" /></mxCell>
