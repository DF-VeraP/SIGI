        <mxCell id="e_ini_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1" source="inv_ini_router" target="inv_ini_collapse">
          <mxGeometry relative="1" as="geometry" />
