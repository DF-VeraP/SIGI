          <mxGeometry x="70" y="235" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf1_f2" value="F1.2 Autenticación JWT Criptográfica:&#xa;Verificación Bcrypt (10 salt rounds) + Firma de Token HMAC" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf1_f3" value="F1.3 Política Forzosa de Primer Acceso:&#xa;Verificación de directiva debe_cambiar_password = 1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="385" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf1_f4" value="F1.4 Recuperación Segura por Correo:&#xa;Generación de Token HMAC SHA-256 (60 min) + Nodemailer SMTP" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf1_f5" value="F1.5 Enrutamiento y Control de Roles:&#xa;RBAC para Reportero, Administrador y Superadministrador" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="540" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf1_out" value="SALIDAS OPERATIVAS:&#xa;- Token JWT en cookie HttpOnly segura&#xa;- Redirección automática a vistas autorizadas&#xa;- Enlace seguro de un solo uso por correo&#xa;- Códigos de estado HTTP (200, 401, 403, 429)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="330" height="110" as="geometry" />
        </mxCell>
