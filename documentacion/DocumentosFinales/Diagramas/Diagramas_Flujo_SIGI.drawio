        <mxCell id="inv_a_modal_mat" value="Abre Modal #modalMatrizDetalle:&#xa;Muestra tabla #tablaMatrizIncidentes con los casos&#xa;ocurridos exactamente en ese día y franja horaria,&#xa;paginados de a 7 por página (#btnPagAntMatriz / #btnPagSigMatriz)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3110" y="790" width="310" height="85" as="geometry" />
