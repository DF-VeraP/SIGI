        <mxCell id="mf6_f5" value="F6.5 Reentrenador Supervisado en Memoria:&#xa;Reconstrucción de vocabulario y probabilidades con Laplace sin reinicio" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1255" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf6_out" value="SALIDAS OPERATIVAS:&#xa;- Cuentas de usuario activas con tokens revocados ante baja&#xa;- Matriz predictiva de IA actualizada en memoria RAM&#xa;- Nuevas tipologías con colores visualmente distinguibles&#xa;- Reporte forense exportable para entes judiciales o de control" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
