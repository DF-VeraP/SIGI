  <diagram id="tab-funcional" name="Diagrama-Funcional">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="func_title" value="DIAGRAMA FUNCIONAL DEL SISTEMA — ARQUITECTURA DE MÓDULOS Y CAPACIDADES SIGI (v2.1)&#xa;Descomposición Funcional de Alto Nivel, Entradas, Procesos y Salidas Operativas" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="2180" height="50" as="geometry" /></mxCell>
        <mxCell id="box_mf1" value="MF-01: Módulo Funcional de Autenticación, Acceso y Seguridad" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="700" height="680" as="geometry" /></mxCell>
        <mxCell id="mf1_in" value="ENTRADAS:&#xa;- Credenciales (Username/Email + Password)&#xa;- Solicitudes de reseteo de contraseña&#xa;- Tokens JWT de encabezado Authorization" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="mf1_f1" value="F1.1 Control de Tráfico &amp; Rate Limiter:&#xa;Bloqueo preventivo por IP (&gt; 5 intentos fallidos en 15 min)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="235" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf1_f2" value="F1.2 Autenticación JWT Criptográfica:&#xa;Verificación Bcrypt (10 salt rounds) + Firma de Token HMAC" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="310" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf1_f3" value="F1.3 Política Forzosa de Primer Acceso:&#xa;Verificación de directiva debe_cambiar_password = 1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="385" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf1_f4" value="F1.4 Recuperación Segura por Correo:&#xa;Generación de Token HMAC SHA-256 (60 min) + Nodemailer SMTP" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf1_f5" value="F1.5 Enrutamiento y Control de Roles:&#xa;RBAC para Reportero, Administrador y Superadministrador" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="540" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf1_out" value="SALIDAS OPERATIVAS:&#xa;- Token JWT en cookie HttpOnly segura&#xa;- Redirección automática a vistas autorizadas&#xa;- Enlace seguro de un solo uso por correo&#xa;- Códigos de estado HTTP (200, 401, 403, 429)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf1_sub" value="Submódulos / Dependencias:&#xa;- controllers/auth.controller.js&#xa;- middleware/rateLimit.middleware.js&#xa;- middleware/auth.middleware.js&#xa;- models/UsuarioModel.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="box_mf2" value="MF-02: Módulo Funcional de Georreferenciación y Geoportal Ciudadano" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="700" height="680" as="geometry" /></mxCell>
        <mxCell id="mf2_in" value="ENTRADAS:&#xa;- Coordenadas de encuadre cartográfico (BBox)&#xa;- Criterios de filtrado (Fechas, tipo, sector, severidad)&#xa;- Eventos de clic sobre marcadores en Leaflet" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="140" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="mf2_f1" value="F2.1 Motor Cartográfico Leaflet.js:&#xa;Carga dinámica de capas base (Satelital Esri, Positron, Dark)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="235" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf2_f2" value="F2.2 Vectorización de Límites Poligonales:&#xa;Renderizado GeoJSON de Barrios urbanos y Veredas rurales" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="310" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf2_f3" value="F2.3 Motor de Filtros Espacio-Temporales:&#xa;Filtrado multi-variable combinado con ajuste automático de vista" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="385" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf2_f4" value="F2.4 Sanitización Estricta de Datos Públicos:&#xa;Filtro WHERE id_estado = 5 y omisión de datos de reporteros" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="460" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf2_f5" value="F2.5 Tablero Analítico y Gráficos KPI:&#xa;Cómputo en tiempo real con Chart.js (Dona, series, Top 10)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="535" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf2_out" value="SALIDAS OPERATIVAS:&#xa;- Mapa temático interactivo con chinchetas agrupadas&#xa;- Popups sanitizados con fotos Cloudinary CDN&#xa;- Capas vectoriales activables/desactivables&#xa;- Tarjetas numéricas y gráficos de tendencias públicas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf2_sub" value="Submódulos / Dependencias:&#xa;- controllers/incidentes.controller.js&#xa;- controllers/estadisticas.controller.js&#xa;- controllers/geografia.controller.js&#xa;- public/dashboard/js/dashboard.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="270" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="box_mf3" value="MF-03: Módulo Funcional de Captura en Campo y Resiliencia Móvil (PWA)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1530" y="90" width="700" height="680" as="geometry" /></mxCell>
        <mxCell id="mf3_in" value="ENTRADAS:&#xa;- Coordenadas GPS del sensor móvil&#xa;- Ajuste manual de chincheta por arrastre&#xa;- Relato textual de los hechos y severidad estimada&#xa;- Fotografía capturada con cámara o galería" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="140" width="310" height="85" as="geometry" /></mxCell>
        <mxCell id="mf3_f1" value="F3.1 Service Worker PWA Offline-First:&#xa;Caché de activos y detección automática de pérdida de señal" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="245" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_f2" value="F3.2 Autolocalización GPS &amp; Contención PostGIS:&#xa;Captura métrica HTML5 + cálculo ST_Contains de barrio/vereda" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="320" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_f3" value="F3.3 Asistente NLP Predictivo (Naive Bayes):&#xa;Clasificación automática de tipología a partir del relato escrito" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="395" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_f4" value="F3.4 Disparador Semántico de Emergencias:&#xa;Activación automática de casillas (Policía/Ambulancia/Bomberos)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="470" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_f5" value="F3.5 Ingesta de Evidencias &amp; Subida Cloudinary:&#xa;Optimización automática de imágenes y compresión web" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="545" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_f6" value="F3.6 Cola Offline &amp; Autosincronización:&#xa;Persistencia en localStorage y despacho secuencial al reconectar" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="620" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf3_out" value="SALIDAS OPERATIVAS:&#xa;- Código radicado oficial único (INC-YYYY-XXXX)&#xa;- Notificación toast y modal de confirmación&#xa;- Transmisión en tiempo real vía WebSockets al backend&#xa;- Historial en &quot;Mis Reportes&quot; con badges semafóricos" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="140" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf3_sub" value="Submódulos / Dependencias:&#xa;- services/ml.service.js&#xa;- public/sw.js&#xa;- public/js/pwa-offline.js&#xa;- public/reportero/js/reportero.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1880" y="270" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="box_mf4" value="MF-04: Módulo Funcional de Mesa de Validación y Monitoreo en Tiempo Real" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="800" width="700" height="740" as="geometry" /></mxCell>
        <mxCell id="mf4_in" value="ENTRADAS:&#xa;- Evento de nuevo incidente radicado en terreno&#xa;- Solicitudes de adquisición / liberación de candado&#xa;- Dictamen técnico del analista (Aprobar / Desestimar)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="850" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="mf4_f1" value="F4.1 Túnel Persistente WebSockets (Socket.io):&#xa;Sala &quot;administradores&quot; con push inmediato a la bandeja" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="945" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf4_f2" value="F4.2 Sintetizador de Tonos Web Audio API:&#xa;Generador de audio armónico nativo (D5 a A5) sin MP3 externo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf4_f3" value="F4.3 Candado de Concurrencia Transaccional:&#xa;Reserva atómica de 10 min por analista con control de conflicto 409" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1095" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf4_f4" value="F4.4 Asistente IA de Validación Cruzada:&#xa;Comparación heurística entre texto original y tipología seleccionada" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1175" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf4_f5" value="F4.5 Emisión y Registro de Dictamen Técnico:&#xa;Aprobación oficial (id_estado = 5) o desestimación con justificación" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1255" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf4_out" value="SALIDAS OPERATIVAS:&#xa;- Fila insertada dinámicamente en cola sin recarga (F5)&#xa;- Bloqueo de botón para otros analistas (&quot;En revisión por...&quot;)&#xa;- Publicación inmediata en Geoportal ante aprobación&#xa;- Registro inmutable de dictamen en bitácora" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="850" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf4_sub" value="Submódulos / Dependencias:&#xa;- server.js (Socket.io)&#xa;- public/js/sigi-realtime.js&#xa;- controllers/incidentes.controller.js&#xa;- models/IncidenteModel.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="980" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="box_mf5" value="MF-05: Módulo Funcional de Analítica Predictiva y Reportes Institucionales" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="790" y="800" width="700" height="740" as="geometry" /></mxCell>
        <mxCell id="mf5_in" value="ENTRADAS:&#xa;- Parámetros temporales y selección de delitos&#xa;- Archivos CSV para ingesta masiva histórica&#xa;- Identificador de lote (batch_id) para Rollback" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="850" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="mf5_f1" value="F5.1 Agrupamiento Espacial DBSCAN &amp; Haversine:&#xa;Cálculo de núcleos críticos (eps = 300m, minPts = 3 incidentes)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="945" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf5_f2" value="F5.2 Proyección Temporal con Suavizado Exponencial:&#xa;Pronóstico delictivo estacional a 4 semanas para patrullaje preventivo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="1020" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf5_f3" value="F5.3 Compilación Dinámica de Reportes PDFKit:&#xa;Generación de informe institucional consolidado por comunas y tipos" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="1100" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf5_f4" value="F5.4 Ingestor Masivo CSV en Streaming:&#xa;Validación de cabeceras, tipos de datos y rangos fila por fila" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="1175" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf5_f5" value="F5.5 Mecanismo Atómico de Rollback:&#xa;Eliminación transaccional limpia y exclusiva de registros de un lote" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="1250" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf5_out" value="SALIDAS OPERATIVAS:&#xa;- Mapa de calor de Hotspots con gradiente cromático&#xa;- Gráficas predictivas con intervalos de confianza&#xa;- Documento PDF estructurado de alta fidelidad con firmas&#xa;- Resumen cuantitativo de filas procesadas y rechazadas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="850" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf5_sub" value="Submódulos / Dependencias:&#xa;- services/ml.service.js&#xa;- controllers/ml.controller.js&#xa;- controllers/reportes.controller.js&#xa;- controllers/tablas.controller.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="980" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="box_mf6" value="MF-06: Módulo Funcional de Gobernanza, Auditoría y Configuración Global" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1530" y="800" width="700" height="740" as="geometry" /></mxCell>
        <mxCell id="mf6_in" value="ENTRADAS:&#xa;- Datos de nuevos usuarios y asignación de roles&#xa;- Órdenes de cambio de estado (Activar/Inactivar)&#xa;- Nuevas tipologías con color hexadecimal en selector&#xa;- Solicitud de reentrenamiento del modelo de IA" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="850" width="310" height="85" as="geometry" /></mxCell>
        <mxCell id="mf6_f1" value="F6.1 Aprovisionamiento de Identidades:&#xa;Generación de claves criptográficas y despacho por email (Nodemailer)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="955" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf6_f2" value="F6.2 Blindaje Institucional de Superadministrador:&#xa;Bloqueo estricto de auto-inactivación y protección del último activo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1030" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf6_f3" value="F6.3 Bitácora Forense Inmutable:&#xa;Registro de auditoría con marca ISO 8601, IP origen, User-Agent y JSON" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1105" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf6_f4" value="F6.4 Validación Cromática Perceptual Redmean:&#xa;Control de colisión de color (DeltaC &lt; 85) e integridad referencial" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1180" width="310" height="60" as="geometry" /></mxCell>
        <mxCell id="mf6_f5" value="F6.5 Reentrenador Supervisado en Memoria:&#xa;Reconstrucción de vocabulario y probabilidades con Laplace sin reinicio" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1255" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="mf6_out" value="SALIDAS OPERATIVAS:&#xa;- Cuentas de usuario activas con tokens revocados ante baja&#xa;- Matriz predictiva de IA actualizada en memoria RAM&#xa;- Nuevas tipologías con colores visualmente distinguibles&#xa;- Reporte forense exportable para entes judiciales o de control" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="850" width="330" height="110" as="geometry" /></mxCell>
        <mxCell id="mf6_sub" value="Submódulos / Dependencias:&#xa;- controllers/usuarios.controller.js&#xa;- controllers/catalogos.controller.js&#xa;- models/UsuarioModel.js&#xa;- models/CatalogosModel.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1880" y="980" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="ef_1_to_3" value="Permisos y Token de Reportero" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf1_f5" target="mf3_f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_1_to_4" value="Permisos y Token de Administrador" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf1_f5" target="mf4_f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_3_to_4" value="WebSocket: nuevo_incidente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf3_f6" target="mf4_f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_4_to_2" value="Incidente Aprobado (Oficial)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf4_f5" target="mf2_f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_4_to_5" value="Datos para Clustering DBSCAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf4_f5" target="mf5_f1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_6_to_3" value="Modelo NLP Reentrenado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf6_f5" target="mf3_f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ef_4_to_6" value="Registro de Dictamen en Auditoría" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="mf4_f5" target="mf6_f3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="tab-erd" name="Diagrama-Entidad-Relacion">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="erd_title" value="DIAGRAMA ENTIDAD-RELACIÓN (ERD) — BASE DE DATOS GEOGRÁFICA POSTGRESQL / POSTGIS (SIGI v2.1)&#xa;Modelo Relacional Espacial, Tablas Maestras, Transaccionales, Geometrías WGS84 EPSG:4326 y Auditoría" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="2400" height="50" as="geometry" /></mxCell>
        <mxCell id="erd_incidente" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;incidente (Transaccional)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; idincidente: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; codigoincidente: VARCHAR(50)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;i&gt;FK idtipoincidente: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK id_estado: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK id_gravedad: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK id_modalidad: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK idbarrio: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK idvereda: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK idusuario: INTEGER (creador)&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK id_admin_revisor: INTEGER (candado)&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;descripcionincidente: TEXT&lt;br/&gt;fechaincidente: DATE&lt;br/&gt;horaincidente: TIME&lt;br/&gt;direccion: TEXT&lt;br/&gt;geom: GEOMETRY(Point, 4326) [GiST]&lt;br/&gt;numero_victimas: INTEGER DEFAULT 1&lt;br/&gt;numero_vehiculos_afectados: INT DEFAULT 0&lt;br/&gt;requiere_ambulancia: BOOLEAN DEFAULT false&lt;br/&gt;requiere_policia: BOOLEAN DEFAULT true&lt;br/&gt;requiere_bomberos: BOOLEAN DEFAULT false&lt;br/&gt;foto_url: TEXT (Cloudinary CDN)&lt;br/&gt;bloqueo_expira: TIMESTAMP (10 min)&lt;br/&gt;fecha_toma_revision: TIMESTAMP&lt;br/&gt;batch_id: VARCHAR(50) (Lote CSV)&lt;br/&gt;motivo_desestimacion: TEXT&lt;br/&gt;fecha_creacion: TIMESTAMP DEFAULT NOW()&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1050" y="380" width="380" height="520" as="geometry" /></mxCell>
        <mxCell id="erd_tipo_incidente" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;tipo_incidente (Catálogo)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; idtipoincidente: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; nametipoincidente: VARCHAR(100)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;i&gt;FK id_categoria: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;codigo: VARCHAR(10)&lt;br/&gt;color: VARCHAR(20) DEFAULT &apos;#6c757d&apos;&lt;br/&gt;nivel_riesgo_base: VARCHAR(20)&lt;br/&gt;tiempo_resolucion_promedio: INTEGER&lt;br/&gt;requiere_visita: BOOLEAN DEFAULT false&lt;br/&gt;activo: BOOLEAN DEFAULT true&lt;br/&gt;fecha_creacion: TIMESTAMP&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="340" height="230" as="geometry" /></mxCell>
