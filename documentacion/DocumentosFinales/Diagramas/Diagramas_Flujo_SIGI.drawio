        <mxCell id="mod_sup_box" value="MÓDULO: Creación de Usuarios y Despacho Automático de Credenciales" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="560" height="770" as="geometry" /></mxCell>
        <mxCell id="sup_start" value="Inicio: Acceso a /superadmin/index.html" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sup_in_user" value="Ingreso de datos en &quot;+ Registrar Nuevo Usuario&quot;:&#xa;Nombre, Username, Email, Rol, Entidad, Teléfono" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="180" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="sup_proc_pass" value="Genera contraseña aleatoria segura (10 caracteres)&#xa;Cifra hash con Bcrypt (10 salt rounds)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="290" width="240" height="60" as="geometry" /></mxCell>
