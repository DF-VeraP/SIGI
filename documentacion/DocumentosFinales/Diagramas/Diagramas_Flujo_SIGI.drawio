        <mxCell id="mf2_f5" value="F2.5 Tablero Analítico y Gráficos KPI:&#xa;Cómputo en tiempo real con Chart.js (Dona, series, Top 10)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="535" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf2_out" value="SALIDAS OPERATIVAS:&#xa;- Mapa temático interactivo con chinchetas agrupadas&#xa;- Popups sanitizados con fotos Cloudinary CDN&#xa;- Capas vectoriales activables/desactivables&#xa;- Tarjetas numéricas y gráficos de tendencias públicas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="330" height="110" as="geometry" />
