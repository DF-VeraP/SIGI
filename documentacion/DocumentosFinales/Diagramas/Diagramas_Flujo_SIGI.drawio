        <mxCell id="erd_gravedad_incidente" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;gravedad_incidente (Catálogo)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; id_gravedad: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; nombre: VARCHAR(50)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;nivel: INTEGER (1-5) [CHECK]&lt;br/&gt;color: VARCHAR(20)&lt;br/&gt;prioridad: INTEGER (1-5) [CHECK]&lt;br/&gt;tiempo_respuesta_horas: INTEGER&lt;br/&gt;descripcion: TEXT&lt;br/&gt;icono: VARCHAR(50)&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="380" width="340" height="210" as="geometry" /></mxCell>
