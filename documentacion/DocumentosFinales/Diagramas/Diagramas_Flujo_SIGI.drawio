        <mxCell id="rep_btn_gps" value="Clic en &quot;Obtener Mi Ubicación (GPS)&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="395" width="240" height="45" as="geometry" /></mxCell>
