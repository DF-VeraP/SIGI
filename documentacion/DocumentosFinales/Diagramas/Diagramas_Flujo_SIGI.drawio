        <!-- =========================================================================================
             MÓDULO 6: BOTÓN DE NAVEGACIÓN "AI LAB" (#vistaIA — LAS 4 PESTAÑAS EN COLUMNAS PARALELAS)
             ========================================================================================= -->
        <mxCell id="mod_inv_ai_box" value="MÓDULO 6: Botón &quot;AI Lab&quot; (#vistaIA — Centro de Machine Learning y sus 4 Pestañas Interactivas)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="3740" y="40" width="1360" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_start" value="Inicio: Invitado pulsa botón &quot;AI Lab&quot;&#xa;(data-view=&quot;ia-hub&quot; -&gt; #vistaIA)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4290" y="90" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_header" value="Inicializa SIGI AI Lab &amp; Machine Learning Hub (inicializarAILab):&#xa;Muestra estado de Motores ML Activos y barra de 4 pestañas (.ai-nav-tabs)&#xa;con scroll vertical (overflow-y) y botón &quot;Reentrenar Modelo ML&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4240" y="180" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_dec_tab" value="¿Qué pestaña del contenedor .ai-nav-tabs&#xa;selecciona el usuario en AI Lab?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4300" y="295" width="240" height="95" as="geometry" />
        </mxCell>
        <!-- Columna 1: Pestaña 1 (Simulador NLP) -->
        <mxCell id="inv_ml_t1_in" value="Pestaña 1: &quot;1. Simulador NLP en Tiempo Real&quot;&#xa;(#tabSimuladorNLP): Ingresa relato en #aiSimuladorInput&#xa;o pulsa chip (Asalto / Riña / Piques / Choque)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3760" y="450" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t1_proc" value="POST /api/ml/predecir-incidente -&gt; MLService:&#xa;- Tokeniza texto (unigramas y bigramas sin stopwords)&#xa;- Clasifica con Multinomial Naive Bayes + Softmax&#xa;- Evalúa 8 disparadores de gravedad (escala 1 a 5)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3760" y="570" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t1_out" value="Renderiza Diagnóstico IA en vivo:&#xa;Tipología predicha + % Confianza, Nivel de Gravedad (1-5),&#xa;Barras de probabilidad y Auxilio (Policía/Ambulancia/Bomberos)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3760" y="690" width="310" height="80" as="geometry" />
        </mxCell>
        <!-- Columna 2: Pestaña 2 (DBSCAN Hotspots) -->
        <mxCell id="inv_ml_t2_in" value="Pestaña 2: &quot;2. Zonas Críticas DBSCAN (Hotspots)&quot;&#xa;(#tabDBSCAN): Selecciona Radio eps (#aiDbscanEps):&#xa;250m (Micro) / 450m (Barrial) / 750m / 1000m" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4095" y="450" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t2_proc" value="GET /api/ml/hotspots?eps=X&amp;minPts=3:&#xa;- Extrae coordenadas y COALESCE(id_gravedad, 3) de BD&#xa;- Ejecuta DBSCAN con distancia esférica de Haversine&#xa;- Agrupa clústeres densos y filtra puntos aislados (Ruido)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4095" y="570" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t2_out" value="Llena tabla #aiTablaClustersBody (Zona, Coordenadas,&#xa;Incidentes, Modalidad, Gravedad Media y Nivel de Riesgo).&#xa;Botón &quot;Ver en Mapa&quot; activa DBSCAN y hace flyTo al clúster" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4095" y="690" width="310" height="80" as="geometry" />
        </mxCell>
        <!-- Columna 3: Pestaña 3 (Forecasting) -->
        <mxCell id="inv_ml_t3_in" value="Pestaña 3: &quot;3. Pronóstico Temporal (Forecasting)&quot;&#xa;(#tabForecast): Selecciona horizonte en #aiForecastMeses:&#xa;Proyectar 3 Meses o Proyectar 6 Meses" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4430" y="450" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t3_proc" value="GET /api/ml/forecast?meses=X:&#xa;- Agrega histórico mensual (TO_CHAR(fechaincidente, &#39;YYYY-MM&#39;))&#xa;- Ajusta Regresión Lineal OLS (y = mx + b)&#xa;- Calcula bandas de confianza al 85%" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4430" y="570" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t3_out" value="Actualiza KPIs (Diagnóstico de Tendencia, Pendiente m,&#xa;Variación %) y grafica curva histórica + pronóstico&#xa;en Chart.js (#chartAIForecast)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4430" y="690" width="310" height="80" as="geometry" />
        </mxCell>
        <!-- Columna 4: Pestaña 4 (CIEPS & MNVCC) -->
        <mxCell id="inv_ml_t4_in" value="Pestaña 4: &quot;4. CIEPS &amp; MNVCC (Hoja de Servicio / TAMIR)&quot;&#xa;(#tabMNVCC): Selecciona Cuadrante Policial&#xa;(CUA-FLO-001 a CUA-FLO-008)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4765" y="450" width="315" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t4_proc" value="GET /api/mnvcc/cuadrantes y /api/mnvcc/hoja-servicio/:id:&#xa;- Cruza jurisdicción del cuadrante con incidentes&#xa;- Consulta puntos críticos CIEPS y actividades TAMIR" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4765" y="570" width="315" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_t4_out" value="Renderiza Hoja de Servicio MNVCC: KPIs del cuadrante,&#xa;Puntos Críticos (5 Porqués e Ishikawa), Tabla TAMIR de&#xa;consignas preventivas y botón Imprimir Hoja de Servicio" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="4765" y="690" width="315" height="80" as="geometry" />
        </mxCell>
        <mxCell id="inv_ml_end" value="Fin: Exploración en Centro de Inteligencia Artificial (AI Lab) completada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="4260" y="845" width="320" height="50" as="geometry" />
        </mxCell>
