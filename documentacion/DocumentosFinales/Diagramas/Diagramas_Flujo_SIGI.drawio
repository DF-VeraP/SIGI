        <mxCell id="mod_rep_rad_box" value="MÓDULO: Gestión de Conectividad (Online vs PWA Offline) &amp; Radicación" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="700" y="40" width="580" height="1020" as="geometry" /></mxCell>
        <mxCell id="rep_rad_start" value="Inicio: Reportero pulsa &quot;Radicar Incidente&quot;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="rep_dec_online" value="¿Dispositivo tiene conexión a Internet?&#xa;(navigator.onLine == true)" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="180" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="rep_off_save" value="Modo Offline Activo:&#xa;Serializa payload y almacena en cola local&#xa;localStorage: sigi_cola_incidentes_offline" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="310" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="rep_off_banner" value="Despliega franja ámbar informativa:&#xa;&quot;Reporte guardado localmente en el móvil&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="425" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="rep_off_listen" value="Service Worker escucha evento:&#xa;window.ononline" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="525" width="180" height="50" as="geometry" /></mxCell>
