  <diagram id="tab-admin" name="Flujo-Admin">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mod_adm_val_box" value="MÓDULO: Mesa de Validación &amp; Control de Concurrencia (Candado 10 min)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="680" height="1440" as="geometry" /></mxCell>
        <mxCell id="adm_start" value="Inicio: Administrador en /admin/index.html" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_proc_ws" value="Socket.io conectado a sala &quot;administradores&quot;&#xa;Escucha evento &quot;nuevo_incidente&quot; en tiempo real" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="180" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_proc_tone" value="Web Audio API sintetiza tono sonoro (D5 a A5)&#xa;Despliega notificación Toast e inserta fila superior" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_proc_click" value="Administrador pulsa &quot;Revisar Incidente&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="380" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="adm_proc_lockreq" value="Solicitud atómica: POST /api/incidentes/:id/tomar" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="465" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_dec_lock" value="¿Caso disponible o candado previo expirado?&#xa;(id_admin_revisor IS NULL OR bloqueo_expira &lt; NOW())" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="555" width="200" height="95" as="geometry" /></mxCell>
        <mxCell id="adm_err_conflict" value="HTTP 409 Conflicto:&#xa;&quot;Caso en evaluación por otro analista&quot;&#xa;Deshabilita botón para los demás analistas" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="575" width="180" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_end_conflict" value="Fin: Caso reservado" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="675" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="adm_proc_setlock" value="Adquisición de Candado:&#xa;UPDATE incidente SET id_admin_revisor = $user,&#xa;id_estado = 2, bloqueo_expira = NOW() + INTERVAL &apos;10 MIN&apos;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="690" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="adm_proc_modal" value="Abre modal de validación exclusiva con fotos Cloudinary&#xa;y mapa interactivo del punto del suceso" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="800" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_proc_ai" value="Consulta Asistente IA (&quot;Sugerencia IA&quot;):&#xa;Compara tipología reportada vs predicción NLP" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="900" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="adm_dec_resol" value="¿Dictamen técnico del Administrador?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="995" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="adm_res_apr" value="Aprobar: POST /:id/resolver&#xa;UPDATE incidente SET id_estado = 5 (&quot;Aprobado&quot;),&#xa;fecha_resolucion = NOW()" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1125" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="adm_res_pub" value="Caso se publica de inmediato en Geoportal público&#xa;y alimenta modelos de Machine Learning" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="1235" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_res_des" value="Desestimar: POST /:id/cerrar&#xa;Valida justificación técnica obligatoria&#xa;UPDATE incidente SET id_estado = 6, motivo = $motivo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1125" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="adm_res_arch" value="Caso se archiva fuera de la vista pública&#xa;Permanece accesible para auditoría" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="1240" width="180" height="55" as="geometry" /></mxCell>
        <mxCell id="adm_res_lib" value="Liberar: POST /:id/liberar&#xa;(O transcurren 10 min de inactividad)&#xa;Restablece id_admin_revisor = NULL, id_estado = 1" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1125" width="170" height="75" as="geometry" /></mxCell>
