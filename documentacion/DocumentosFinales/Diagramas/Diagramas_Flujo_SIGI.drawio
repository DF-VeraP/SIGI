        <mxCell id="mf6_f2" value="F6.2 Blindaje Institucional de Superadministrador:&#xa;Bloqueo estricto de auto-inactivación y protección del último activo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
