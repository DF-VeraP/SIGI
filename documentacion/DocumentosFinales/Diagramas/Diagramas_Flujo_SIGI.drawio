        <mxCell id="erd_incidente_factores" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;incidente_factores (Pivote M:N)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; id_incidente_factor: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; UNIQUE (id_incidente, id_factor)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;i&gt;FK id_incidente: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;i&gt;FK id_factor: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;fecha_asociacion: TIMESTAMP DEFAULT NOW()&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="320" height="160" as="geometry" /></mxCell>
