        <mxCell id="erd_token" value="&lt;p style=&quot;margin:0px;text-align:center;font-size:12px;&quot;&gt;&lt;b&gt;token / reset_tokens (Criptográfico)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;b&gt;[PK]&lt;/b&gt; id_token: SERIAL&lt;br/&gt;&lt;b&gt;[UK]&lt;/b&gt; token: VARCHAR(255)&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;&lt;i&gt;FK id_usuario: INTEGER&lt;/i&gt;&lt;br/&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #000000;margin:6px 0;&quot;/&gt;&lt;p style=&quot;margin:0px;line-height:1.35;&quot;&gt;tipo: VARCHAR(30) [reset_password, verificacion]&lt;br/&gt;expiracion: TIMESTAMP (60 min)&lt;br/&gt;usado: BOOLEAN DEFAULT false&lt;br/&gt;fecha_creacion: TIMESTAMP DEFAULT NOW()&lt;br/&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=10;spacingTop=6;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2060" y="980" width="360" height="210" as="geometry" /></mxCell>
