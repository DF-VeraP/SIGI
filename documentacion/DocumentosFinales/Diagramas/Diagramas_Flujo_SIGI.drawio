        <mxCell id="auth_proc_modal" value="Modal forzoso de cambio de clave:&#xa;Ingresa nueva clave (&gt;= 8 caracteres)&#xa;bcrypt.hash() -&gt; UPDATE usuarios&#xa;SET debe_cambiar_password = 0" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="1070" width="200" height="85" as="geometry" /></mxCell>
