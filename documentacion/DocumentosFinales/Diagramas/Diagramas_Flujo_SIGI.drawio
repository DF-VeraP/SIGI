        <mxCell id="mod_adm_pdf_box" value="MÓDULO: Generación de Reportes Oficiales Ejecutivos en PDF" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1310" y="40" width="480" height="870" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_start" value="Inicio: Pestaña &quot;Reportes Ejecutivos&quot;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_in" value="Selección de mes y año institucional (o rango)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="180" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_click" value="Clic en &quot;Generar Reporte Oficial PDF&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="270" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_query" value="Backend consulta base de datos PostgreSQL:&#xa;Consolida tipologías, variaciones y comunas" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="355" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_kit" value="Motor PDFKit compila dinámicamente el documento:&#xa;- Portada oficial institucional&#xa;- Tablas estadísticas formateadas&#xa;- Resumen ejecutivo y firmas de control" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="455" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_stream" value="Transmite archivo con Content-Type: application/pdf" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="575" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_down" value="Descarga automática en navegador:&#xa;Reporte_Ejecutivo_SIGI_[MES]_[AÑO].pdf" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1430" y="665" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="adm_pdf_end" value="Fin: Documento listo para comités" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="765" width="240" height="45" as="geometry" /></mxCell>
