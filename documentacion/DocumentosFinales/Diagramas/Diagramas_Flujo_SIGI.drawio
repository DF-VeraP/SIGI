          <mxGeometry x="400" y="980" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="box_mf5" value="MF-05: Módulo Funcional de Analítica Predictiva y Reportes Institucionales" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="790" y="800" width="700" height="740" as="geometry" />
        </mxCell>
        <mxCell id="mf5_in" value="ENTRADAS:&#xa;- Parámetros temporales y selección de delitos&#xa;- Archivos CSV para ingesta masiva histórica&#xa;- Identificador de lote (batch_id) para Rollback" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="850" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="mf5_f1" value="F5.1 Agrupamiento Espacial DBSCAN &amp; Haversine:&#xa;Cálculo de núcleos críticos (eps = 300m, minPts = 3 incidentes)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="945" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf5_f2" value="F5.2 Proyección Temporal con Suavizado Exponencial:&#xa;Pronóstico delictivo estacional a 4 semanas para patrullaje preventivo" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="1020" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf5_f3" value="F5.3 Compilación Dinámica de Reportes PDFKit:&#xa;Generación de informe institucional consolidado por comunas y tipos" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="1100" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf5_f4" value="F5.4 Ingestor Masivo CSV en Streaming:&#xa;Validación de cabeceras, tipos de datos y rangos fila por fila" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="1175" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf5_f5" value="F5.5 Mecanismo Atómico de Rollback:&#xa;Eliminación transaccional limpia y exclusiva de registros de un lote" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="1250" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mf5_out" value="SALIDAS OPERATIVAS:&#xa;- Mapa de calor de Hotspots con gradiente cromático&#xa;- Gráficas predictivas con intervalos de confianza&#xa;- Documento PDF estructurado de alta fidelidad con firmas&#xa;- Resumen cuantitativo de filas procesadas y rechazadas" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="850" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mf5_sub" value="Submódulos / Dependencias:&#xa;- services/ml.service.js&#xa;- controllers/ml.controller.js&#xa;- controllers/reportes.controller.js&#xa;- controllers/tablas.controller.js" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="980" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="box_mf6" value="MF-06: Módulo Funcional de Gobernanza, Auditoría y Configuración Global" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
