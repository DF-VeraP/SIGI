        <mxCell id="adm_an_in" value="Selección de ventana temporal y tipologías" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_an_req_dbscan" value="Solicitud: GET /api/ml/hotspots" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_an_dbscan" value="Algoritmo DBSCAN con distancia de Haversine:&#xa;Agrupa focos con eps = 300m y minPts = 3 incidentes" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_an_map_render" value="Renderiza mapa de calor interactivo con gradiente cromático&#xa;(Verde -&gt; Amarillo -&gt; Rojo según densidad crítica)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="465" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_an_req_fore" value="Solicitud: GET /api/ml/forecast" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="570" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_an_fore" value="Modelo de Suavizado Exponencial (Exponential Smoothing):&#xa;Calcula proyección delictiva para las próximas 4 semanas" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_an_chart" value="Renderiza gráfico de tendencia con bandas de predicción&#xa;para planificación de patrullajes preventivos" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="765" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_an_end" value="Fin: Diagnóstico predictivo completado" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="870" width="240" height="45" as="geometry" /></mxCell>
        <mxCell id="eaa1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="adm_an_start" target="adm_an_in"><mxGeometry relative="1" as="geometry" /></mxCell>
