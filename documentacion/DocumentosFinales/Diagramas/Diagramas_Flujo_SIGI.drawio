        <mxCell id="rep_on_post" value="Envío de payload al servidor:&#xa;POST /api/incidentes con coordenadas y foto" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="410" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="rep_on_db" value="Backend inserta incidente en PostgreSQL:&#xa;Asigna id_estado = 1 (&quot;Reportado&quot;)&#xa;Genera código radicado INC-YYYY-XXXX" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="510" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="rep_on_ws" value="Servidor emite evento WebSocket &quot;nuevo_incidente&quot;&#xa;a la sala institucional de &quot;administradores&quot;" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="620" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="rep_on_res" value="Retorna respuesta exitosa HTTP 201 Created" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="720" width="240" height="50" as="geometry" /></mxCell>
