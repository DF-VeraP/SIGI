        <mxCell id="box_mf2" value="MF-02: Módulo Funcional de Georreferenciación y Geoportal Ciudadano" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="700" height="680" as="geometry" />
        </mxCell>
        <mxCell id="mf2_in" value="ENTRADAS:&#xa;- Coordenadas de encuadre cartográfico (BBox)&#xa;- Criterios de filtrado (Fechas, tipo, sector, severidad)&#xa;- Eventos de clic sobre marcadores en Leaflet" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="310" height="75" as="geometry" />
        </mxCell>
        <mxCell id="mf2_f1" value="F2.1 Motor Cartográfico Leaflet.js:&#xa;Carga dinámica de capas base (Satelital Esri, Positron, Dark)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="235" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf2_f2" value="F2.2 Vectorización de Límites Poligonales:&#xa;Renderizado GeoJSON de Barrios urbanos y Veredas rurales" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="310" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf2_f3" value="F2.3 Motor de Filtros Espacio-Temporales:&#xa;Filtrado multi-variable combinado con ajuste automático de vista" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="385" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mf2_f4" value="F2.4 Sanitización Estricta de Datos Públicos:&#xa;Filtro WHERE id_estado = 5 y omisión de datos de reporteros" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="460" width="310" height="60" as="geometry" />
