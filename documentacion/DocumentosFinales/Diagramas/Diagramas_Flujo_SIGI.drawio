  <diagram id="tab-negocio" name="Diagrama-Negocio">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lane_ciudadania" value="ACTOR DE NEGOCIO:&#xa;Ciudadanía de Florencia (Comunidad)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="40" width="420" height="1600" as="geometry" /></mxCell>
        <mxCell id="lane_campo" value="ACTOR DE NEGOCIO:&#xa;Personal Operativo en Campo (Policía / Tránsito)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="490" y="40" width="440" height="1600" as="geometry" /></mxCell>
        <mxCell id="lane_mesa" value="ACTOR DE NEGOCIO:&#xa;Mesa Técnica de Validación (Analistas / Gobierno)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="950" y="40" width="440" height="1600" as="geometry" /></mxCell>
        <mxCell id="lane_mando" value="ACTOR DE NEGOCIO:&#xa;Nivel Estratégico &amp; Comités de Orden Público" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1410" y="40" width="420" height="1600" as="geometry" /></mxCell>
        <mxCell id="lane_gob" value="ACTOR DE NEGOCIO:&#xa;Gobernanza &amp; Administración General SIGI" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1850" y="40" width="400" height="1600" as="geometry" /></mxCell>
        <mxCell id="biz_start" value="Inicio de Negocio:&#xa;Ocurrencia de hecho delictivo, accidente&#xa;o contravención en sector de Florencia" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="280" height="60" as="geometry" /></mxCell>
        <mxCell id="biz_ciud_alerta" value="Actividad de Negocio:&#xa;Ciudadano alerta al cuadrante policial&#xa;o inspector mediante llamada / en terreno" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_campo_arribo" value="Actividad de Negocio:&#xa;Patrulla arriba a las coordenadas del suceso&#xa;y verifica la situación de seguridad" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="190" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_campo_pwa" value="Actividad de Negocio:&#xa;Apertura de aplicativo SIGI Móvil (PWA)&#xa;Autolocalización GPS métrica y evidencia fotográfica" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="290" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_campo_ia" value="Asistencia Tecnológica en Negocio:&#xa;Asistente NLP sugiere tipología delictiva y&#xa;activa auxilio médico/policial según relato" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="395" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_campo_dec_net" value="Decisión Operativa:&#xa;¿Cobertura de red móvil en el sector?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="500" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="biz_campo_offline" value="Regla de Negocio (Offline-First):&#xa;Almacena en cola segura de dispositivo.&#xa;Sincroniza automáticamente al retomar red" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_campo_radica" value="Actividad de Negocio:&#xa;Radicación formal con código institucional&#xa;(INC-YYYY-XXXX). Transmisión inmediata" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="620" width="210" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_mesa_recep" value="Actividad de Negocio:&#xa;Recepción en tiempo real en pantalla de mando&#xa;Alerta auditiva armónica y visual (WebSockets)" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="620" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_mesa_lock" value="Regla de Control de Concurrencia:&#xa;Candado exclusivo de 10 minutos.&#xa;Impide dictámenes duplicados o contradictorios" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="725" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_mesa_dec_valid" value="Decisión de Negocio (Dictamen):&#xa;¿El hecho cumple criterios de veracidad,&#xa;consistencia territorial y evidencia fotográfica?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="830" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="biz_mesa_desestimar" value="Dictamen: Desestimado / Rechazado&#xa;Ingreso obligatorio de motivo técnico formal.&#xa;Queda archivado para trazabilidad y auditoría" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="970" width="200" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_mesa_aprobar" value="Dictamen: Aprobado / Oficializado&#xa;Incidente cobra estatus de dato oficial institucional&#xa;para seguridad pública municipal" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="970" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_mando_ingesta" value="Procesamiento de Inteligencia:&#xa;Ingesta atómica en repositorio PostGIS&#xa;Alimentación de modelos espaciales y temporales" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="970" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="biz_mando_hotspots" value="Actividad de Negocio:&#xa;Cálculo de núcleos delictivos críticos (Hotspots DBSCAN)&#xa;y pronóstico de incidentes a 4 semanas" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="1080" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="biz_mando_pdf" value="Entregable de Negocio:&#xa;Generación de Reporte Ejecutivo Oficial PDF&#xa;para Consejo Municipal de Seguridad" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="1190" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="biz_mando_decision" value="Decisión Táctica de Mando:&#xa;Asignación prioritaria de patrullas, turnos de vigilancia&#xa;e intervenciones sociales focalizadas" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1480" y="1300" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_campo_patrulla" value="Resultado de Negocio:&#xa;Patrullas y cuadrantes se despliegan en&#xa;sectores de mayor vulnerabilidad identificados" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="1305" width="280" height="65" as="geometry" /></mxCell>
        <mxCell id="biz_ciud_geoportal" value="Valor Ciudadano de Negocio:&#xa;Acceso libre al Geoportal Cartográfico&#xa;Visualización de zonas seguras, estadísticas y KPIs" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="970" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="biz_ciud_control" value="Control Social &amp; Convivencia:&#xa;Comunidad informada toma medidas de autoprotección&#xa;y participa en frentes de seguridad barriales" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1305" width="280" height="65" as="geometry" /></mxCell>
