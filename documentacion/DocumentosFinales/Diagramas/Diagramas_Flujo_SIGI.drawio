        <mxCell id="auth_err_rl" value="HTTP 429: Bloqueo temporal por 15 min&#xa;gestorIps.registrarBloqueo(ip)&#xa;io.emit(&quot;ip_bloqueada&quot;) a Superadmin" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="295" width="200" height="60" as="geometry" /></mxCell>
