        <mxCell id="mod_adm_csv_box" value="MÓDULO: Ingesta Masiva CSV y Reversión Atómica (Rollback)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalFlip=0;verticalFlip=0;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1820" y="40" width="520" height="1080" as="geometry" /></mxCell>
        <mxCell id="adm_csv_start" value="Inicio: Pestaña &quot;Importación Masiva&quot;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1960" y="90" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_in" value="Carga de archivo .csv estructurado según plantilla" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="180" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_proc" value="Procesamiento en streaming fila a fila:&#xa;Valida tipos de datos, rangos geográficos y obligatoriedad" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="270" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_csv_dec_val" value="¿Archivo contiene registros válidos?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="375" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="adm_csv_err" value="Rechazo de lote con reporte detallado de errores" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2190" y="395" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_insert" value="Inserción transaccional atómica en PostgreSQL:&#xa;Asigna batch_id único a todos los registros del lote" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="505" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_csv_res" value="Reporta total de filas importadas con éxito" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="610" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_dec_roll" value="¿Usuario solicita revertir importación?&#xa;(Clic en &quot;Deshacer Última Importación&quot;)" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="700" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="adm_csv_roll_conf" value="Solicita confirmación de seguridad con batch_id" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2190" y="795" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_roll_del" value="DELETE FROM incidente WHERE batch_id = $batchId&#xa;Eliminación atómica y exclusiva del lote" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2180" y="885" width="150" height="65" as="geometry" /></mxCell>
        <mxCell id="adm_csv_roll_ok" value="Restaura mapa al estado anterior e informa" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2180" y="990" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="adm_csv_ok_keep" value="Registros quedan consolidados definitivamente en el sistema" style="whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="830" width="240" height="55" as="geometry" /></mxCell>
        <mxCell id="adm_csv_end" value="Fin: Operación de importación concluida" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1960" y="925" width="240" height="45" as="geometry" /></mxCell>
