        <mxCell id="eac10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontColor=#000000;fontFamily=Helvetica;fontSize=10;" edge="1" parent="1" source="adm_csv_roll_del" target="adm_csv_roll_ok"><mxGeometry relative="1" as="geometry" /></mxCell>
