        <mxCell id="inv_a_dec_cell" value="¿Invitado hace clic en una celda&#xa;Día × Hora con incidentes (&gt; 0)?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="3280" y="655" width="220" height="90" as="geometry" />
