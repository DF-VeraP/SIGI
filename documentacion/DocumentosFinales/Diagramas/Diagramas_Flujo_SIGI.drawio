        <mxCell id="mf1_in" value="ENTRADAS:&#xa;- Credenciales (Username/Email + Password)&#xa;- Solicitudes de reseteo de contraseña&#xa;- Tokens JWT de encabezado Authorization" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;strokeWidth=1;fillColor=#ffffff;fontColor=#000000;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
