        <mxCell id="e_ini_4" value="Cambiar Tema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="inv_ini_dec_act" target="inv_ini_tema">
