          </mxGeometry>
        </mxCell>
        <mxCell id="arr_3_5" edge="1" parent="1" source="c_backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;strokeColor=#000000;strokeWidth=1.5;fontFamily=Arial;fontSize=11;fontColor=#000000;" target="c_cloud" value="Streaming de Evidencias / Despacho de Tokens">
          <mxGeometry relative="1" x="0.5278" as="geometry">
