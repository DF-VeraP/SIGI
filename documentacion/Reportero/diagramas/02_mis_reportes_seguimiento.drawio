        </mxCell>

        <mxCell id="db_user_inc" value="PostgreSQL&#xa;SELECT i.*, ti.nametipoincidente,&#xa;ei.nombre as estado, b.namebarrio&#xa;FROM incidente i&#xa;WHERE i.id_usuario_creador = $1&#xa;ORDER BY i.fecharegistro DESC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
