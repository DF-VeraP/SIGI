          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="modal_view" value="Modal de Detalle y Trazabilidad:&#xa;1. Foto Cloudinary en Alta Resolución&#xa;2. Coordenadas y marcador en Leaflet&#xa;3. Observaciones del Validador / Motivo de Cierre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
