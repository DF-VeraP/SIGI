        <!-- DB Postgres -->
        <mxCell id="db_grid" value="PostgreSQL&#xa;SELECT i.*, ti.nametipoincidente,&#xa;ei.nombre as estado, gi.nombre as gravedad,&#xa;b.namebarrio, u.nombreusuario&#xa;FROM incidente i ...&#xa;ORDER BY i.fechaincidente DESC" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
