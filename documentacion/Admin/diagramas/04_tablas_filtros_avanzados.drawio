        <!-- UI Data Grid -->
        <mxCell id="ui_grid" value="Cuadrícula Data Grid y Filtros&#xa;1. Panel rediseñado (Layout 2 filas)&#xa;2. Buscador reactivo por código (#filtroCodigo)&#xa;3. Filtros combinados + Badge contador dinámico&#xa;4. Paginación y acciones (Detalle/Foto/Editar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
