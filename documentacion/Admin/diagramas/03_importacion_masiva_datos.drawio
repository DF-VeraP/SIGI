<mxfile host="app.diagrams.net" modified="2026-10-06T13:05:00.000Z" agent="SIGI-Architecture" version="22.0.0" type="device">
  <diagram id="diag-admin-03" name="03_Importacion_Masiva_Datos">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="adm_act3" value="Admin / Analista" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- UI Modal Importación -->
        <mxCell id="ui_imp" value="Modal de Importación Masiva&#xa;1. Carga de archivo CSV / Excel&#xa;2. Barra de progreso / 'Subir Lote'&#xa;3. Botón 'Deshacer Última Importación'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="220" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ec1" value="Carga archivo tabular" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="adm_act3" target="ui_imp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Parser Backend -->
        <mxCell id="box_parse" value="Procesador Masivo&#xa;controllers/incidentes.controller.js&#xa;1. Valida columnas obligatorias y tipos&#xa;2. Geocodificación y asignación id_lote&#xa;3. Inserción con origen = 'masivo'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="215" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="ec2" value="POST /importar-incidentes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ui_imp" target="box_parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Base de Datos Postgres -->
        <mxCell id="db_batch" value="PostgreSQL / PostGIS&#xa;BEGIN TRANSACTION;&#xa;INSERT INTO incidente&#xa;(..., origen='masivo', id_lote=$lote);&#xa;COMMIT;&#xa;Log: 'IMPORTACION_MASIVA'" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="195" width="240" height="170" as="geometry" />
        </mxCell>

        <mxCell id="ec3" value="Inserción en bloque (Lote atómico)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="box_parse" target="db_batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reversión Rollback -->
        <mxCell id="box_undo" value="Mecanismo de Reversión Atómica:&#xa;DELETE /importados/ultimo&#xa;WHERE id_lote = (Último Lote Masivo)&#xa;Log: 'DESHACER_IMPORTACION'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="430" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ec4" value="Solicita Deshacer Último" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ui_imp" target="box_undo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="ec5" value="Elimina lote completo por id_lote" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="box_undo" target="db_batch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="ec6" value="Reporte: éxitos vs fallidos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="db_batch" target="box_parse">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
