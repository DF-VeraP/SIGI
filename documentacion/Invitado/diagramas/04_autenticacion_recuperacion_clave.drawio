<mxfile host="app.diagrams.net" modified="2026-10-06T13:05:00.000Z" agent="SIGI-Architecture" version="22.0.0" type="device">
  <diagram id="diag-invitado-04" name="04_Autenticacion_Recuperacion_Clave">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="user_act" value="Usuario Invitado /&#xa;Registrado" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="40" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ui_login" value="Portal de Login y Recuperación&#xa;public/login/index.html&#xa;1. Entrada de credenciales + Visor de clave&#xa;2. Formulario de recuperación por correo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="220" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e_l1" value="1. Envía credenciales&#xa;o solicita restablecimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="user_act" target="ui_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rate Limiter -->
        <mxCell id="rl_check" value="Rate Limit Guard&#xa;loginLimiter (5 / 15m)&#xa;recuperarLimiter (3 / 15m)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="180" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e_l2" value="Petición POST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ui_login" target="rl_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Auth Controller -->
        <mxCell id="ctrl_auth" value="Controlador de Autenticación&#xa;controllers/auth.controller.js&#xa;iniciarSesion() / solicitarRecuperacion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="225" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e_l3" value="IP permitida" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="rl_check" target="ctrl_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bloqueado Rate limit -->
        <mxCell id="box_429" value="Error 429: Demasiadas&#xa;solicitudes. Bloqueo temporal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_l4" value="Límite superado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="rl_check" target="box_429">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Base de Datos -->
        <mxCell id="db_sec" value="PostgreSQL&#xa;Tablas: usuario, token, auditoria_logs&#xa;Bcrypt (10 rondas)&#xa;¿debe_cambiar_password?" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="110" width="180" height="130" as="geometry" />
        </mxCell>

        <mxCell id="e_l5" value="Verifica hash /&#xa;Valida estado activo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ctrl_auth" target="db_sec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Mailer -->
        <mxCell id="smtp_mail" value="Nodemailer / Gmail SMTP&#xa;utils/mailer.js&#xa;Token criptográfico SHA-256 (1 hora)&#xa;URL firmada de restablecimiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="310" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e_l6" value="Despacha enlace seguro&#xa;de restablecimiento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ctrl_auth" target="smtp_mail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Interceptor Primer Ingreso -->
        <mxCell id="box_must_change" value="Forzado de Cambio de Clave:&#xa;Si debe_cambiar_password = true,&#xa;bloquea navegación e impone nueva clave (HU-REP-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="640" y="440" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_l7" value="Bandera activa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" edge="1" parent="1" source="ctrl_auth" target="box_must_change">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

